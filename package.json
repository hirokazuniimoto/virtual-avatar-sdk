{
  "name": "virtual-avatar",
  "version": "0.1.1",
  "description": "Web向け・軽量アバターランタイム - アバターに詳しくないWeb開発者でも「喋るアバター体験」を最短で実装",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && rollup -c",
    "dev": "tsc --watch",
    "serve": "npx serve . -p 3000",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "avatar",
    "vrm",
    "three.js",
    "lip-sync",
    "animation",
    "web"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hirokazuniimoto/virtual-avatar-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/hirokazuniimoto/virtual-avatar-sdk/issues"
  },
  "homepage": "https://github.com/hirokazuniimoto/virtual-avatar-sdk#readme",
  "dependencies": {
    "three": "^0.160.0",
    "@pixiv/three-vrm": "^3.4.4",
    "@pixiv/three-vrm-animation": "^3.4.4"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "typescript": "^5.0.0",
    "rollup": "^4.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-commonjs": "^25.0.0"
  }
}

